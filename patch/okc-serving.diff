+@triton.jit
+def _ngram_append_kernel(
+    hist_ptr,
+    req_pool_indices_ptr,
+    prefix_lens_ptr,
+    candidates_ptr,  # [bs, block_size]; col 0 is the bonus that just committed
+    out_tokens_ptr,  # [bs, block_size]; the committed block, bonus' at commit_len - 1
+    commit_lens_ptr,  # [bs]
+    cand_row_stride,
+    out_row_stride,
+    window,
+    block_size,
+    BLOCK_SIZE_P2: tl.constexpr,
+):
+    row = tl.program_id(0)
+    req_idx = tl.load(req_pool_indices_ptr + row).to(tl.int64)
+    seq_len = tl.load(prefix_lens_ptr + row).to(tl.int64)
+    wmask = (window - 1).to(tl.int64)
+    hist_row = hist_ptr + req_idx * window
+    bonus = tl.load(candidates_ptr + row * cand_row_stride)
+    tl.store(hist_row + (seq_len & wmask), bonus.to(tl.int32))
+    commit = tl.load(commit_lens_ptr + row)
+    cols = tl.arange(0, BLOCK_SIZE_P2)
+    mask = (cols < commit) & (cols < block_size)
+    toks = tl.load(out_tokens_ptr + row * out_row_stride + cols, mask=mask, other=0)
+    tl.store(hist_row + ((seq_len + 1 + cols) & wmask), toks.to(tl.int32), mask=mask)
