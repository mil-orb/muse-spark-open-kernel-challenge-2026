+  static void
+  run(const tvm::ffi::TensorView w,
+      const tvm::ffi::TensorView gs,
+      const tvm::ffi::TensorView src,
+      const tvm::ffi::TensorView order,
+      const tvm::ffi::TensorView offs,
+      const tvm::ffi::TensorView dst,
+      const tvm::ffi::TensorView ctl,
+      int64_t phase,
+      int64_t nt,
+      int64_t grid,
+      int64_t mode) {
+    using namespace host;
+    namespace k = okc_moe_prefill_rp;
+    auto device = SymbolicDevice{};
+    device.set_options<kDLCUDA>();
+    RuntimeCheck(phase == 1 || phase == 2, "phase must be 1 or 2");
+    TensorMatcher({k::kExperts, (phase == 1 ? 16 : 8) * k::kUnitStages, k::kStageWeightBytes / 4})
+        .with_dtype<int32_t>().with_device(device).verify(w);
+    TensorMatcher({k::kExperts}).with_device(device).verify(gs);
+    TensorMatcher({-1, 4096}).with_dtype<bf16_t>().with_device(device).verify(src);
+    TensorMatcher({-1}).with_dtype<int32_t>().with_device(device).verify(order);
+    TensorMatcher({k::kExperts}).with_dtype<int32_t>().with_device(device).verify(offs);
+    TensorMatcher({-1, 4096}).with_dtype<bf16_t>().with_device(device).verify(dst);
+    TensorMatcher({-1}).with_dtype<int32_t>().with_device(device).verify(ctl);
+    RuntimeCheck(grid >= 1, "grid must be positive");
+    RuntimeCheck(src.size(0) >= 1, "src must have rows");
+    const auto params = k::Params{
+        .src_map = row_map(src.data_ptr(), src.size(0), static_cast<int>(nt) * 8, nt == 16 && OKC_PF_SW),
+        .w = static_cast<const uint32_t*>(w.data_ptr()),
+        .gs = static_cast<const uint16_t*>(gs.data_ptr()),
+        .src = static_cast<const __nv_bfloat16*>(src.data_ptr()),
+        .order = static_cast<const int32_t*>(order.data_ptr()),
+        .offs = static_cast<const int32_t*>(offs.data_ptr()),
+        .dst = static_cast<__nv_bfloat16*>(dst.data_ptr()),
+        .ctl = static_cast<int32_t*>(ctl.data_ptr()),
+        .mode = static_cast<int>(mode & 255),
+        .fit = static_cast<int>((mode >> 8) & 1),
+    };
+    const int g = static_cast<int>(grid);
+    const DLDevice dev = device.unwrap();
+    if (nt == 16) {
+      phase == 1 ? launch_wide<1>(params, g, dev) : launch_wide<2>(params, g, dev);
+    } else if (nt == 8) {
+      phase == 1 ? launch<8, 1>(params, g, dev) : launch<8, 2>(params, g, dev);
+    } else if (nt == 4) {
+      phase == 1 ? launch<4, 1>(params, g, dev) : launch<4, 2>(params, g, dev);
+    } else {
+      RuntimeCheck(false, "nt must be 4, 8 or 16");
+    }
+  }
+};
+
+}  // namespace sglang
