+def _pow2_at_most(n: int) -> int:
+    p = 1
+    while p * 2 <= n:
+        p *= 2
+    return p
+
+
+class NgramDrafter:
+    """History rings plus the two launches. One instance per worker."""
+
+    def __init__(
+        self,
+        *,
+        num_rows: int,
+        context_len: int,
+        block_size: int,
+        device: torch.device,
+        min_match: int = 8,
+        history_budget_bytes: int = 64 << 20,
+        pin_memory: bool = True,
