diff --git a/python/sglang/kernels/ops/speculative/ngram_lookup.py b/python/sglang/kernels/ops/speculative/ngram_lookup.py
new file mode 100644
index 0000000..4f3e608
--- /dev/null
+++ b/python/sglang/kernels/ops/speculative/ngram_lookup.py
@@ -0,0 +1,265 @@
+# SPDX-License-Identifier: Apache-2.0
+# 2026 the patch authors
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+# ==============================================================================
+"""Per-request prompt-lookup (n-gram) drafting for a linear verify block.
+
+Each request keeps a ring of its own committed token ids (prompt plus outputs),
+indexed by its ``req_to_token`` row. Before the target verify, one program per
+request looks for the most recent earlier occurrence of the tokens that end at
+the bonus token and, on a long enough match, writes the tokens that followed it
+straight into the draft slots of the verify block. Verify decides what commits,
+so a wrong continuation costs a step, never a token (greedy accept).
+
+Nothing is shared across requests and nothing is read from the host: both
+kernels take GPU tensors the DFlash step already holds, run eagerly between the
+draft and verify graph replays, and never sync.
+"""
+
+from typing import Sequence
+
+import torch
+import triton
+import triton.language as tl
+
+# Longest match the lookup measures and the first comparisons every block pays
+# for before the rest run only on blocks with a 3-gram hit.
+MAX_MATCH = 32
+PREFILTER = 3
+
+
+@triton.jit
+def _ngram_lookup_kernel(
+    hist_ptr,  # int32 [rows, window]
+    req_pool_indices_ptr,  # [bs]
+    prefix_lens_ptr,  # [bs], committed length L; the bonus sits at position L
+    draft_tokens_ptr,  # int64 [bs, block_size]; col 0 = bonus, cols 1.. rewritten on a hit
+    match_len_out_ptr,  # int32 [bs], 0 when the slots were left alone
+    draft_row_stride,
+    window,  # power of two
+    block_size,
+    min_match,
+    MAX_MATCH: tl.constexpr,
+    PREFILTER: tl.constexpr,
+    BLOCK: tl.constexpr,
+    BLOCK_SIZE_P2: tl.constexpr,
+):
+    row = tl.program_id(0)
+    req_idx = tl.load(req_pool_indices_ptr + row).to(tl.int64)
+    seq_len = tl.load(prefix_lens_ptr + row).to(tl.int64)
+    wmask = (window - 1).to(tl.int64)
+    hist_row = hist_ptr + req_idx * window
+    bonus = tl.load(draft_tokens_ptr + row * draft_row_stride).to(tl.int32)
+    # Oldest position still in the ring. The slot of position L itself may hold
+    # the token L - window tokens back, so stop one short of it.
+    lo = tl.maximum(seq_len - window + 1, 0)
+
+    # key[i] is the token at position L - i; i = 0 is the bonus (not in the ring yet).
+    ki = tl.arange(0, MAX_MATCH)
+    kpos = seq_len - ki
+    key = tl.load(hist_row + (kpos & wmask), mask=(ki > 0) & (kpos >= lo), other=-1)
+    key = tl.where(ki == 0, bonus, key)
+
+    best_m = tl.full((), 0, tl.int32)
+    best_j = tl.full((), -1, tl.int64)
+    offs = tl.arange(0, BLOCK)
+    # Candidate end positions j in [lo, L - 1], most recent block first, so a
+    # strictly-greater update breaks ties toward recency.
+    num_blocks = (seq_len - lo + BLOCK - 1) // BLOCK
+    for b in range(num_blocks):
+        if best_m < MAX_MATCH:
+            j = seq_len - 1 - b * BLOCK - offs
+            alive = j >= lo
+            m = tl.zeros((BLOCK,), dtype=tl.int32)
+            # Loads are masked on the ring bound only, so they do not wait on
+            # each other's comparison.
+            for i in tl.static_range(PREFILTER):
+                p = j - i
+                tok = tl.load(hist_row + (p & wmask), mask=p >= lo, other=-1)
+                k_i = tl.sum(tl.where(ki == i, key, 0), 0)
+                alive = alive & (p >= lo) & (tok == k_i)
+                m += alive.to(tl.int32)
+            if tl.max(m, 0) >= PREFILTER:
+                for i in tl.static_range(PREFILTER, MAX_MATCH):
+                    p = j - i
+                    tok = tl.load(hist_row + (p & wmask), mask=p >= lo, other=-1)
+                    k_i = tl.sum(tl.where(ki == i, key, 0), 0)
+                    alive = alive & (p >= lo) & (tok == k_i)
+                    m += alive.to(tl.int32)
+            bm = tl.max(m, 0)
+            if bm > best_m:
+                best_m = bm
+                best_j = tl.max(tl.where(m == bm, j, -1), 0)
+
+    # Continuation: the tokens after j, as many as exist below L (a splice keeps
+    # the drafter's tokens in the slots past the end of the history).
+    n_avail = tl.minimum(seq_len - 1 - best_j, (block_size - 1).to(tl.int64))
+    use = (best_m >= min_match) & (best_j >= 0) & (n_avail > 0)
+    cols = tl.arange(0, BLOCK_SIZE_P2)
+    pos = best_j + 1 + cols
+    col_mask = use & (cols < n_avail) & (cols < block_size - 1)
+    toks = tl.load(hist_row + (pos & wmask), mask=col_mask, other=0)
+    tl.store(
+        draft_tokens_ptr + row * draft_row_stride + 1 + cols,
+        toks.to(tl.int64),
+        mask=col_mask,
+    )
+    tl.store(match_len_out_ptr + row, tl.where(use, best_m, 0))
