+
+struct OkcMoePrefillRp {
+  using EncodeFn = CUresult (*)(CUtensorMap*, CUtensorMapDataType, cuuint32_t, void*, const cuuint64_t*,
+                                const cuuint64_t*, const cuuint32_t*, const cuuint32_t*, CUtensorMapInterleave,
+                                CUtensorMapSwizzle, CUtensorMapL2promotion, CUtensorMapFloatOOBfill);
+
+  static EncodeFn encoder() {
+    static EncodeFn fn = nullptr;
+    if (fn == nullptr) {
+      void* ptr = nullptr;
+      cudaDriverEntryPointQueryResult q;
+      host::RuntimeDeviceCheck(cudaGetDriverEntryPointByVersion("cuTensorMapEncodeTiled", &ptr, 12000,
+                                                                cudaEnableDefault, &q));
+      host::RuntimeCheck(q == cudaDriverEntryPointSuccess && ptr != nullptr, "cuTensorMapEncodeTiled not found");
+      fn = reinterpret_cast<EncodeFn>(ptr);
+    }
+    return fn;
+  }
+
+  // Rows of a [rows][4096] bf16 tensor, box of 8 columns by tok rows, no swizzle.
+  static CUtensorMap row_map(const void* base, int64_t rows, int tok, bool swizzle) {
+    CUtensorMap map;
+    const cuuint64_t dims[2] = {4096, static_cast<cuuint64_t>(rows)};
+    const cuuint64_t strides[1] = {4096 * 2};
+    const cuuint32_t box[2] = {swizzle ? 64u : 8u, static_cast<cuuint32_t>(tok)};
+    const cuuint32_t elem[2] = {1, 1};
+    const CUresult r = encoder()(&map, CU_TENSOR_MAP_DATA_TYPE_BFLOAT16, 2, const_cast<void*>(base), dims, strides,
+                                 box, elem, CU_TENSOR_MAP_INTERLEAVE_NONE,
+                                 swizzle ? CU_TENSOR_MAP_SWIZZLE_128B : CU_TENSOR_MAP_SWIZZLE_NONE,
+                                 CU_TENSOR_MAP_L2_PROMOTION_L2_256B, CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE);
+    host::RuntimeCheck(r == CUDA_SUCCESS, "tensor map encode failed");
+    return map;
+  }
+
+  static void gather(const tvm::ffi::TensorView x, const tvm::ffi::TensorView order, const tvm::ffi::TensorView offs,
+                     const tvm::ffi::TensorView xs) {
+    using namespace host;
+    namespace k = okc_moe_prefill_rp;
+    auto device = SymbolicDevice{};
+    device.set_options<kDLCUDA>();
+    TensorMatcher({-1, 4096}).with_dtype<bf16_t>().with_device(device).verify(x);
+    auto R = SymbolicSize{"R"};
+    TensorMatcher({R}).with_dtype<int32_t>().with_device(device).verify(order);
+    TensorMatcher({k::kExperts}).with_dtype<int32_t>().with_device(device).verify(offs);
+    TensorMatcher({R, 4096}).with_dtype<bf16_t>().with_device(device).verify(xs);
+    const int64_t rows = R.unwrap();
+    if (rows == 0) return;
+    LaunchKernel(dim3(static_cast<unsigned>((rows + 7) / 8)), 256, device.unwrap(), 0)(
+        k::okc_gather_rows_kernel, static_cast<const __nv_bfloat16*>(x.data_ptr()),
+        static_cast<const int32_t*>(order.data_ptr()), static_cast<const int32_t*>(offs.data_ptr()),
+        static_cast<__nv_bfloat16*>(xs.data_ptr()));
+  }
+
+  // Route plan on the device: order (stable by local expert, other routes last) and offs, as the torch path.
+  static void plan(const tvm::ffi::TensorView ids, const tvm::ffi::TensorView counts, const tvm::ffi::TensorView order,
+                   const tvm::ffi::TensorView offs) {
+    using namespace host;
+    namespace k = okc_moe_prefill_rp;
+    auto device = SymbolicDevice{};
+    device.set_options<kDLCUDA>();
+    auto R = SymbolicSize{"R"};
+    TensorMatcher({R}).with_dtype<int32_t>().with_device(device).verify(ids);
+    TensorMatcher({R}).with_dtype<int32_t>().with_device(device).verify(order);
+    TensorMatcher({-1}).with_dtype<int32_t>().with_device(device).verify(counts);
+    TensorMatcher({k::kExperts}).with_dtype<int32_t>().with_device(device).verify(offs);
+    const int64_t rows = R.unwrap();
+    const int64_t chunks = (rows + k::kPlanChunk - 1) / k::kPlanChunk;
+    RuntimeCheck(rows > 0 && rows < (int64_t{1} << 31), "plan needs 1 .. 2^31 - 1 routes");
+    RuntimeCheck(counts.size(0) >= chunks * k::kPlanBuckets, "counts workspace too small");
+    const DLDevice dev = device.unwrap();
+    const auto* ip = static_cast<const int32_t*>(ids.data_ptr());
+    auto* cp = static_cast<int32_t*>(counts.data_ptr());
+    LaunchKernel(dim3(static_cast<unsigned>(chunks)), k::kPlanThreads, dev, 0)(k::okc_plan_count_kernel, ip, rows, cp);
+    LaunchKernel(dim3(static_cast<unsigned>(chunks)), k::kPlanThreads, dev, 0)(
+        k::okc_plan_scatter_kernel, ip, rows, static_cast<const int32_t*>(cp), static_cast<int>(chunks),
+        static_cast<int32_t*>(order.data_ptr()), static_cast<int32_t*>(offs.data_ptr()));
+  }
+
+  template <int NT, int PHASE>
+  static void launch(const okc_moe_prefill_rp::Params& params, int grid, DLDevice device) {
+    namespace k = okc_moe_prefill_rp;
+    const size_t smem = sizeof(k::Shared<NT>);
+    static bool attr_set = false;
+    if (!attr_set) {
+      host::RuntimeDeviceCheck(cudaFuncSetAttribute(
+          k::okc_moe_prefill_rp_kernel<NT, PHASE>, cudaFuncAttributeMaxDynamicSharedMemorySize, static_cast<int>(smem)));
+      attr_set = true;
+    }
+    host::LaunchKernel(dim3(static_cast<unsigned>(grid)), k::kThreads, device, smem)(
+        k::okc_moe_prefill_rp_kernel<NT, PHASE>, params);
+  }
+
+  template <int PHASE>
+  static void launch_wide(const okc_moe_prefill_rp::Params& params, int grid, DLDevice device) {
+    namespace k = okc_moe_prefill_rp::wide;
+    const size_t smem = sizeof(k::Shared) + 1024;
+    static bool attr_set = false;
+    if (!attr_set) {
+      host::RuntimeDeviceCheck(cudaFuncSetAttribute(k::kernel<PHASE>, cudaFuncAttributeMaxDynamicSharedMemorySize,
+                                                    static_cast<int>(smem)));
+      attr_set = true;
+    }
+    host::LaunchKernel(dim3(static_cast<unsigned>(grid)), k::kThreads, device, smem)(k::kernel<PHASE>, params);
+  }
