+        self.block_size = int(block_size)
+        self.min_match = int(min_match)
+        self.device = device
+        self.pin_memory = bool(pin_memory)
+        self.hist = torch.zeros((num_rows, self.window), dtype=torch.int32, device=device)
+        self.match_len = torch.zeros((num_rows,), dtype=torch.int32, device=device)
+        self.steps = 0
+        self._block_p2 = triton.next_power_of_2(self.block_size)
+
+    def write_prompt(self, req_pool_index: int, token_ids: Sequence[int]) -> None:
+        """Copy the last ``window`` tokens of a request's prompt-so-far into its ring."""
+        end = len(token_ids)
+        start = max(0, end - self.window)
+        n = end - start
+        if n <= 0:
+            return
+        seg = token_ids[start:end]
+        try:
+            # array('q') from Req.get_fill_ids(): a zero-copy view.
+            src = torch.frombuffer(seg, dtype=torch.int64)
+        except (TypeError, ValueError, AttributeError):
+            src = torch.tensor(seg, dtype=torch.int64)
+        # Stage in pinned memory so the copy is enqueued on the stream instead
+        # of syncing it (a pageable copy would wait for the prefill in flight).
+        cpu = torch.empty((n,), dtype=torch.int32, pin_memory=self.pin_memory)
+        cpu.copy_(src)
+        row = self.hist[req_pool_index]
+        s0 = start & (self.window - 1)
+        first = min(n, self.window - s0)
+        row[s0 : s0 + first].copy_(cpu[:first], non_blocking=self.pin_memory)
+        if first < n:
+            row[: n - first].copy_(cpu[first:], non_blocking=self.pin_memory)
+
+    def propose(
+        self,
+        *,
+        draft_tokens: torch.Tensor,
+        req_pool_indices: torch.Tensor,
+        prefix_lens: torch.Tensor,
+    ) -> torch.Tensor:
+        """Rewrite the draft slots of matched rows in place; returns match lengths."""
+        bs = int(draft_tokens.shape[0])
+        match_len = self.match_len[:bs]
+        if bs == 0:
+            return match_len
+        _ngram_lookup_kernel[(bs,)](
+            self.hist,
+            req_pool_indices,
+            prefix_lens,
+            draft_tokens,
+            match_len,
+            draft_tokens.stride(0),
+            self.window,
+            self.block_size,
+            self.min_match,
+            MAX_MATCH=MAX_MATCH,
+            PREFILTER=PREFILTER,
+            BLOCK=1024,
+            BLOCK_SIZE_P2=self._block_p2,
+            num_warps=4,
+        )
+        self.steps += 1
+        return match_len
+
+    def append(
+        self,
+        *,
+        candidates: torch.Tensor,
+        out_tokens: torch.Tensor,
+        commit_lens: torch.Tensor,
+        req_pool_indices: torch.Tensor,
+        prefix_lens: torch.Tensor,
+    ) -> None:
+        """Record the step's committed block: the old bonus at L, then out_tokens."""
+        bs = int(candidates.shape[0])
+        if bs == 0:
+            return
+        _ngram_append_kernel[(bs,)](
+            self.hist,
+            req_pool_indices,
+            prefix_lens,
+            candidates,
+            out_tokens,
+            commit_lens,
+            candidates.stride(0),
+            out_tokens.stride(0),
+            self.window,
+            self.block_size,
+            BLOCK_SIZE_P2=self._block_p2,
+            num_warps=1,
+        )
