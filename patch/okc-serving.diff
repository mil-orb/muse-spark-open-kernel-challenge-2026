+# sizes up to 768 total rows and matched it at every tested size from 1025
+# up, so the floor also stays clear of that boundary.
+POOLER_MIN_TOTAL_ROWS = UNPOOLER_MIN_TOTAL_ROWS
+
+
+def supported(group, x, weight, *, replicated: bool) -> bool:
+    """Check only host metadata; every rank must have the same input layout."""
+    if not replicated or group is None or group.world_size < 2:
+        return False
+    if x.dim() != 2 or weight.dim() != 2 or x.shape[0] == 0:
+        return False
+    if not x.is_cuda or torch.cuda.get_device_capability(x.device)[0] != 9:
+        return False
+    if x.dtype != torch.bfloat16 or weight.dtype != x.dtype:
+        return False
+    if x.device != weight.device or x.shape[1] != weight.shape[1]:
+        return False
+    if weight.shape[0] == 0 or not x.is_contiguous() or not weight.is_contiguous():
+        return False
+    if group.pymscclpp_comm is not None:
+        return False
+    comm = group.pynccl_comm
+    if comm is None or not comm.available:
+        return False
+    if torch.cuda.is_current_stream_capturing() and comm.disabled:
+        return False
