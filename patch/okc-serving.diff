diff --git a/python/sglang/kernels/ops/moe/okc_moe_decode.py b/python/sglang/kernels/ops/moe/okc_moe_decode.py
new file mode 100644
index 0000000..0b98710
--- /dev/null
+++ b/python/sglang/kernels/ops/moe/okc_moe_decode.py
@@ -0,0 +1,145 @@
+# SPDX-License-Identifier: Apache-2.0
+# 2026 the patch authors
+
+"""Persistent fused NVFP4 expert path for decode and verify sizes (1 <= M <= 256).
+
+Same contract as stock `_marlin_expert_outputs`: returns per-route expert
+outputs [M, top_k, H] (rows of nonlocal routes unspecified) and the local ids
+used by stock's `fused_post_expert_norm_weighted_sum`. Reads the weights that
+stock `prepare_moe_nvfp4_layer_for_marlin` leaves on the layer, unchanged.
+One kernel launch per call; see okc_moe_decode.cuh for the design.
+"""
+
+from __future__ import annotations
+
+from functools import lru_cache
+from types import SimpleNamespace
+from typing import Optional
+
+import torch
+
+_MAX_ROUTES = 2048
+_PART_BYTES = 40 << 20
+
+
+@lru_cache(None)
+def _module():
+    from sglang.kernels.jit.utils import load_jit
+
+    import os
+
+    exp = int(os.environ.get("OKC_DEC_EXP", "0"))  # experiment builds only
+    rp = _rp()
+    bal = int(os.environ.get("OKC_DEC_BAL", "30"))  # cost-weighted stage ranges, slope in 1/100
+    fence = int(os.environ.get("OKC_DEC_FENCE", "1"))  # single-thread release / acquire at cut-unit hand-offs
+    name = "okc_moe_decode" + (f"_exp{exp}" if exp else "") + ("_rp" if rp else "") + (f"_bal{bal}" if bal else "")
+    name += "_fence" if fence else ""
+    evf = int(os.environ.get("OKC_DEC_EVF", "1"))  # L2 evict-first hint on stage-block weight copies
+    name += "_evf" if evf else ""
+    tbl = int(os.environ.get("OKC_DEC_TBL", "1"))  # warp-scan chunk table instead of a serial loop
+    name += "_tbl" if tbl else ""
+    return load_jit(
+        name,
+        cuda_files=["gemm/okc_moe_decode/okc_moe_decode.cuh"],
+        cuda_wrappers=[("run", "OkcMoeDecode::run"), ("control_ints", "OkcMoeDecode::control_ints")],
+        extra_cuda_cflags=["-O3", "-lineinfo", f"-DOKC_DEC_EXP={exp}", f"-DOKC_DEC_RP={int(rp)}", f"-DOKC_DEC_BAL={bal}", f"-DOKC_DEC_FENCE={fence}", f"-DOKC_DEC_EVF={evf}", f"-DOKC_DEC_TBL={tbl}"],
+    )
+
+
+def _rp() -> bool:
+    """Read the stage-block layout of okc_moe_repack.py (serving default; 0 is the old Marlin-layout build)."""
+    import os
+
+    return os.environ.get("OKC_DEC_RP", "1") == "1"
+
+
+def _weights(layer):
+    if getattr(layer, "_okc_rp", False):  # okc_moe_rp.okc_rp_prepare repacked the layer in place
+        return layer.w13_weight, layer.w2_weight
+    if not _rp():
+        return layer.w13_weight, layer.w2_weight
+    cached = getattr(layer, "_okc_rp_weights", None)
+    if cached is None:
+        from sglang.kernels.ops.moe.okc_moe_repack import okc_repack_layer
+
+        cached = okc_repack_layer(layer.w13_weight, layer.w13_weight_scale, layer.w2_weight, layer.w2_weight_scale)
+        layer._okc_rp_weights = cached
+    return cached
+
+
+_WORKSPACE: dict = {}
+
+
+def _workspace(device: torch.device) -> SimpleNamespace:
+    key = (device.type, device.index)
+    ws = _WORKSPACE.get(key)
+    if ws is None:
+        ctl_ints = int(_module().control_ints())
+        ws = SimpleNamespace(
+            ctl=torch.zeros((ctl_ints,), dtype=torch.int32, device=device),
+            z=torch.empty((_MAX_ROUTES, 4096), dtype=torch.bfloat16, device=device),
+            part=torch.empty((_PART_BYTES // 4,), dtype=torch.float32, device=device),
+            sms=torch.cuda.get_device_properties(device).multi_processor_count,
+        )
+        _WORKSPACE[key] = ws
+    return ws
+
+
+def okc_decode_applies(layer, hidden_states: torch.Tensor, topk: int) -> bool:
+    if not hidden_states.is_cuda or torch.cuda.get_device_capability(hidden_states.device) != (9, 0):
+        return False
+    return (
+        hidden_states.dim() == 2
+        and 1 <= hidden_states.shape[0] <= _MAX_ROUTES // 8
+        and hidden_states.shape[1] == 4096
+        and hidden_states.dtype == torch.bfloat16
+        and layer.num_local_experts == 32
+        and layer.intermediate_size_per_partition == 4096
+        and layer.w13_weight_scale.dtype == torch.float8_e4m3fn
+        and layer.w2_weight_scale.dtype == torch.float8_e4m3fn
+        and layer.w13_weight_scale_2.dtype == torch.bfloat16
+        and getattr(layer, "w13_bias", None) is None
+        and getattr(layer, "w2_bias", None) is None
+        and topk == 8
+    )
+
+
+def okc_decode_expert_outputs(
+    layer,
+    hidden_states: torch.Tensor,
+    topk_scores: torch.Tensor,
+    topk_ids: torch.Tensor,
+    split: Optional[int] = None,
+    mode: int = 0,
+    grid: Optional[int] = None,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Same contract as stock `_marlin_expert_outputs` (scores are applied by the finalize).
+
+    `split` is accepted for older callers and ignored: work is split by equal
+    stage ranges per CTA.
+    """
+    del topk_scores, split
+    x = hidden_states.contiguous()
+    num_tokens = x.shape[0]
+    topk = topk_ids.shape[1]
+    ids = topk_ids.to(torch.int32)
+    id_base = getattr(layer, "_okc_first_expert", None)
+    if id_base is None:
+        # Not a contiguous expert block (or not checked at load): map on the host side as stock does.
+        id_base = 0
+        if layer._expert_map is not None:
+            from sglang.srt.layers.moe.token_dispatcher.standard import _map_topk_ids_to_local_experts
+
+            ids = _map_topk_ids_to_local_experts(ids, layer._expert_map)
+    ids = ids.contiguous()
+    local_ids = torch.empty((num_tokens, topk), dtype=torch.int32, device=x.device)
+    ws = _workspace(x.device)
+    out = torch.empty((num_tokens * topk, 4096), dtype=x.dtype, device=x.device)
+    w13, w2 = _weights(layer)
+    _module().run(
+        w13, layer.w13_weight_scale, layer.w13_weight_scale_2,
+        w2, layer.w2_weight_scale, layer.w2_weight_scale_2,
+        x, ids.view(-1), local_ids.view(-1), id_base, out, ws.z, ws.part, ws.ctl,
+        grid or ws.sms, mode,
+    )
+    return out.view(num_tokens, topk, 4096), local_ids
diff --git a/python/sglang/kernels/ops/moe/okc_moe_prefill_rp.py b/python/sglang/kernels/ops/moe/okc_moe_prefill_rp.py
new file mode 100644
index 0000000..e4daac5
--- /dev/null
+++ b/python/sglang/kernels/ops/moe/okc_moe_prefill_rp.py
@@ -0,0 +1,108 @@
+# SPDX-License-Identifier: Apache-2.0
+# 2026 the patch authors
+
+"""Fused NVFP4 expert GEMMs for prefill sizes on the stage-block layout.
+
+Same contract as stock `_marlin_expert_outputs`: per-route expert outputs
+[M, top_k, 4096] (rows of nonlocal routes unspecified) and the local ids for
+stock's finalize. Reads the okc_moe_repack.py stage blocks, the layout the
+decode kernel reads. Two kernel launches per call; see okc_moe_prefill_rp.cuh.
+No host syncs: the route plan (stable sort by local expert, per-expert ends)
+stays on the device and the kernels size their tile lists from it.
+"""
+from __future__ import annotations
+
+import os
+from functools import lru_cache
+from types import SimpleNamespace
+
+import torch
+
+_E = 32
+_WS: dict = {}
+
+
+@lru_cache(None)
+def _module():
+    from sglang.kernels.jit.utils import load_jit
+
+    pad = int(os.environ.get("OKC_PF_PAD", "0"))  # diagnostic builds only
+    dbg = int(os.environ.get("OKC_PF_DBG", "0"))
+    kb = int(os.environ.get("OKC_PF_KB", "8"))
+    sw = int(os.environ.get("OKC_PF_SW", "1"))
+    tn = int(os.environ.get("OKC_PF_TN", "1"))  # wide tiles: wgmma N fitted to the tile's routes
+    epv = int(os.environ.get("OKC_PF_EPV", "1"))  # wide epilogue: staged 16 B stores
+    sym = int(os.environ.get("OKC_PF_SYM", "0"))  # wide phase-1 epilogue split over both warpgroups
+    evf = int(os.environ.get("OKC_PF_EVF", "0"))  # weight stage copies as L2 evict_first
+    return load_jit(
+        "okc_moe_prefill_rp" + (f"_pad{pad}" if pad else "") + (f"_dbg{dbg}" if dbg else "") + (f"_kb{kb}" if kb != 8 else "") + ("_sw0" if not sw else "") + ("_tn0" if not tn else "") + ("_epv0" if not epv else "") + ("_sym" if sym else "") + ("_evf" if evf else ""),
+        cuda_files=["gemm/okc_moe_prefill_rp/okc_moe_prefill_rp.cuh"],
+        cuda_wrappers=[("run", "OkcMoePrefillRp::run"), ("gather", "OkcMoePrefillRp::gather"), ("plan", "OkcMoePrefillRp::plan")],
+        extra_cuda_cflags=["-O3", "-lineinfo", f"-DOKC_PF_PAD={pad}", f"-DOKC_PF_DBG={dbg}", f"-DOKC_PF_KB={kb}", f"-DOKC_PF_SW={sw}", f"-DOKC_PF_TN={tn}", f"-DOKC_PF_EPV={epv}", f"-DOKC_PF_SYM={sym}", f"-DOKC_PF_EVF={evf}"],
+    )
+
+
+def _workspace(device: torch.device) -> SimpleNamespace:
+    key = (device.type, device.index)
+    ws = _WS.get(key)
+    if ws is None:
+        ws = SimpleNamespace(
+            ctl=torch.zeros((64,), dtype=torch.int32, device=device),
+            bounds=torch.arange(1, _E + 1, dtype=torch.int32, device=device),
+            sms=torch.cuda.get_device_properties(device).multi_processor_count,
+        )
+        _WS[key] = ws
+    return ws
+
+
+# Wide tiles fit wgmma N to their used routes below this many tokens (bitwise equal either way).
+_FIT_MAX_M = int(os.environ.get("OKC_PF_FIT_MAX", "12288"))
+# Route plan on the device (two launches) instead of torch.where + stable sort + searchsorted; same order and offs.
+_PLAN = os.environ.get("OKC_PF_PLAN", "1") == "1"
+
+
+def route_plan(local: torch.Tensor, ws: SimpleNamespace, device_plan: bool | None = None):
+    """order (int32, stable by local expert, other routes last) and offs[e] (end of expert e)."""
+    flat = local.view(-1)
+    if device_plan is None:
+        device_plan = _PLAN
+    if device_plan and flat.numel() > 0:
+        chunks = (flat.numel() + 2047) // 2048
+        counts = torch.empty((chunks * (_E + 1),), dtype=torch.int32, device=flat.device)
+        order = torch.empty((flat.numel(),), dtype=torch.int32, device=flat.device)
+        offs = torch.empty((_E,), dtype=torch.int32, device=flat.device)
+        _module().plan(flat, counts, order, offs)
+        return order, offs
+    keys = torch.where(flat < 0, _E, flat)
+    sorted_keys, order = torch.sort(keys, stable=True)
+    order = order.to(torch.int32)
+    offs = torch.searchsorted(sorted_keys, ws.bounds, out_int32=True)
+    return order, offs
+
+
+def okc_prefill_rp_expert_outputs(layer, hidden_states, topk_scores, topk_ids, w13_rp, w2_rp,
+                                  nt: int = 8, mode: int = 0, grid=None):
+    del topk_scores
+    x = hidden_states.contiguous()
+    m = x.shape[0]
+    topk = topk_ids.shape[1]
+    local = topk_ids.to(torch.int32)
+    if layer._expert_map is not None:
+        from sglang.srt.layers.moe.token_dispatcher.standard import _map_topk_ids_to_local_experts
+
+        local = _map_topk_ids_to_local_experts(local, layer._expert_map)
+    local = local.contiguous()
+    ws = _workspace(x.device)
+    order, offs = route_plan(local, ws)
+    rows = m * topk
+    out = torch.empty((rows, 4096), dtype=torch.bfloat16, device=x.device)
+    xs = out  # gathered rows live in the output buffer until phase 2 writes it
+    z = torch.empty((rows, 4096), dtype=torch.bfloat16, device=x.device)
+    g = grid or ws.sms
+    if nt == 16 and m < _FIT_MAX_M:
+        mode |= 256  # fit wgmma N to each tile's routes: 15-17% faster at 1,792-3,012 rows, 1% slower at 16,384
+    mod = _module()
+    mod.gather(x, order, offs, xs)
+    mod.run(w13_rp, layer.w13_weight_scale_2, xs, order, offs, z, ws.ctl, 1, nt, g, mode)
+    mod.run(w2_rp, layer.w2_weight_scale_2, z, order, offs, out, ws.ctl, 2, nt, g, mode)
+    return out.view(m, topk, 4096), local
diff --git a/python/sglang/kernels/ops/moe/okc_moe_repack.py b/python/sglang/kernels/ops/moe/okc_moe_repack.py
new file mode 100644
index 0000000..24386ae
--- /dev/null
+++ b/python/sglang/kernels/ops/moe/okc_moe_repack.py
@@ -0,0 +1,183 @@
+# SPDX-License-Identifier: Apache-2.0
+# 2026 the patch authors
+
+"""Stage-contiguous NVFP4 expert layout for the persistent decode kernel.
+
+The decode kernel reads one 36,864-byte block per stage: the codes and block
+scales of 128 k by 512 output channels of one expert, in the order its
+consumer threads load them. This file builds that layout from the tensors
+stock `prepare_moe_nvfp4_layer_for_marlin` leaves on the layer, and holds a
+torch decoder of the layout for tests.
+
+Stage block (blk, st), 32,768 bytes of codes then 4,096 bytes of scales:
+- code word ((warp * 4 + v) * 32 + lane) * 4 + cw is the A fragment of
+  k tile kt = 2 v + (cw >> 1) and 16-row tile wp = 2 (warp & 1) + (cw & 1)
+  of strip warp >> 1, for lane = 4 g + t:
+  register a0 (row g, k 2t + h), a1 (row g + 8, k 2t + h),
+  a2 (row g, k 2t + 8 + h), a3 (row g + 8, k 2t + 8 + h), h = 0, 1.
+- bit order inside a code word: the E2M1 bits (m, e0, e1, s) of register r,
+  half h, sit at _PLACE[r][h]. The kernel decodes the word with
+    a0 = (w << 2) & T
+    a1 = (w << 6) & T
+    a2 = rotl(w, 12) & T
+    a3 = (w & 0x81808180) + ((w & 0x40004000) >> 8)
+  where T = 0x81C081C0 puts each value's sign at bit 15 and e1 e0 m at
+  bits 8..6 of a bf16 half, so each half reads as the E2M1 value * 2^-126.
+  docs: design/LAYOUT-decode.md has the derivation.
+- scale word ((warp * 8 + g) * 8 + 2 v + j) holds, for tile j of the warp,
+  the stock-prepared scale bytes of (row g, kt 2v), (row g, kt 2v + 1),
+  (row g + 8, kt 2v), (row g + 8, kt 2v + 1) as bytes 0..3.
+  Byte b reads as the bf16 with bits (b << 4) + (112 << 7), which equals
+  stock's bf16 scale (E4M3 value * 2^7) for every nonzero byte.
+- a group whose scale byte is 0 has its codes cleared, since the uniform
+  scale decode does not give 0 for byte 0. Every product stays 0.
+
+Phase 1 (w13, 8192 rows: 4096 gate then 4096 up) has 16 blocks; strip s of
+block blk is gate rows 64 (4 blk + s) for s < 4 and up rows 4096 + 64 (4 blk
++ s - 4) otherwise. Phase 2 (w2, 4096 rows) has 8 blocks; strip s of block
+blk is rows 64 (8 blk + s). Both have 32 stages of 128 k (K = 4096).
+"""
+from __future__ import annotations
+
+import torch
+
+STAGE_WORDS = 9216  # 36,864 bytes
+T_MASK = 0x81C081C0
+
+# _PLACE[r][h] = word bit of (m, e0, e1, s) for register r, half h.
+_PLACE = (
+    ((4, 5, 6, 13), (20, 21, 22, 29)),
+    ((0, 1, 2, 9), (16, 17, 18, 25)),
+    ((26, 27, 28, 3), (10, 11, 12, 19)),
+    ((14, 7, 8, 15), (30, 23, 24, 31)),
+)
+
+
+def okc_scale_column_inverse(device=None) -> torch.Tensor:
+    """inv[n] = storage position, within a block of 64, of logical column n in stock's scale prep."""
+    first = [i + 8 * j for i in range(8) for j in range(8)]
+    swap = [0, 2, 1, 3]
+    perm = torch.tensor([first[4 * (q // 4) + swap[q % 4]] for q in range(64)], dtype=torch.long)
+    inv = torch.empty_like(perm)
+    inv[perm] = torch.arange(64)
+    return inv.to(device)
+
+
+def _logical_scale_bytes(scales: torch.Tensor) -> torch.Tensor:
+    """[K/16, N] stock-prepared bytes with columns back in logical order."""
+    s = scales.view(torch.uint8)
+    n = s.shape[-1]
+    inv = okc_scale_column_inverse(s.device)
+    cols = (torch.arange(n, device=s.device) // 64 * 64).view(-1, 64) + inv
+    return s[:, cols.reshape(-1)]
+
+
+def _transcode_words(words: torch.Tensor, zero_c: torch.Tensor) -> torch.Tensor:
+    """Marlin words (nibble i = 4a + 2c + b) to this layout's bit order.
+
+    zero_c[..., c] marks the row half c whose scale byte is 0; its nibbles are cleared.
+    """
+    w = words.to(torch.int64) & 0xFFFFFFFF
+    out = torch.zeros_like(w)
+    for i in range(8):
+        a, c, b = i >> 2, (i >> 1) & 1, i & 1
+        r = c + 2 * b
+        nib = (w >> (4 * i)) & 15
+        nib = torch.where(zero_c[..., c], torch.zeros_like(nib), nib)
+        for q in range(4):
+            out |= ((nib >> q) & 1) << _PLACE[r][a][q]
+    return out.to(torch.uint32).view(torch.int32) if hasattr(torch, "uint32") else \
+        torch.where(out >= 2**31, out - 2**32, out).to(torch.int32)
+
+
+def okc_repack_expert(qweight: torch.Tensor, scales: torch.Tensor, phase: int) -> torch.Tensor:
+    """One expert's stock-prepared tensors to [blocks * 32, STAGE_WORDS] int32."""
+    k_tiles, words = qweight.shape
+    n = words // 2
+    assert k_tiles == 256 and n == (8192 if phase == 1 else 4096)
+    sb = _logical_scale_bytes(scales)  # [256, n]
+    # zero mask per Marlin word and row half: word col = nt*128 + lane*4 + wp,
+    # row = 64 nt + 16 wp + 8 c + (lane >> 2)
+    nt = torch.arange(n // 64, device=qweight.device).view(-1, 1, 1, 1)
+    lane = torch.arange(32, device=qweight.device).view(1, -1, 1, 1)
+    wp = torch.arange(4, device=qweight.device).view(1, 1, -1, 1)
+    c = torch.arange(2, device=qweight.device).view(1, 1, 1, -1)
+    rows = (64 * nt + 16 * wp + 8 * c + (lane >> 2)).reshape(-1)  # [(nt lane wp) c]
+    zero = (sb[:, rows] == 0).view(k_tiles, words, 2)
+    words_new = _transcode_words(qweight, zero)  # [256, words]
+    if phase == 1:
+        # rows (st, v, hb); cols (half, blk, s4, lane, jh, j)
+        cw = words_new.view(32, 4, 2, 2, 16, 4, 32, 2, 2)
+        cw = cw.permute(4, 0, 3, 5, 7, 1, 6, 2, 8)  # blk st half s4 jh v lane hb j
+        ss = sb.view(32, 4, 2, 2, 16, 4, 2, 2, 2, 8)  # st v hb half blk s4 jh j c g
+        ss = ss.permute(4, 0, 3, 5, 6, 9, 1, 7, 8, 2)  # blk st half s4 jh g v j c hb
+        blocks = 16
+    else:
+        cw = words_new.view(32, 4, 2, 8, 8, 32, 2, 2)  # st v hb blk s lane jh j
+        cw = cw.permute(3, 0, 4, 6, 1, 5, 2, 7)  # blk st s jh v lane hb j
+        ss = sb.view(32, 4, 2, 8, 8, 2, 2, 2, 8)  # st v hb blk s jh j c g
+        ss = ss.permute(3, 0, 4, 5, 8, 1, 6, 7, 2)  # blk st s jh g v j c hb
+        blocks = 8
+    codes = cw.reshape(blocks * 32, 8192)
+    sw = ss.reshape(blocks * 32, 4096).contiguous().view(torch.int32)  # [stages, 1024]
+    return torch.cat([codes, sw], dim=1).contiguous()
+
+
+def okc_repack_layer(w13: torch.Tensor, s13: torch.Tensor, w2: torch.Tensor, s2: torch.Tensor):
+    """Stock-prepared [E, ...] tensors to the two stage-block tensors."""
+    e = w13.shape[0]
+    r13 = torch.empty((e, 512, STAGE_WORDS), dtype=torch.int32, device=w13.device)
+    r2 = torch.empty((e, 256, STAGE_WORDS), dtype=torch.int32, device=w2.device)
+    for i in range(e):
+        r13[i] = okc_repack_expert(w13[i], s13[i], 1)
+        r2[i] = okc_repack_expert(w2[i], s2[i], 2)
+    return r13, r2
+
+
+def okc_scale_stats(scales: torch.Tensor) -> dict:
+    """Counts of stock-prepared scale bytes that are 0, from E4M3 subnormals, or normal."""
+    b = scales.view(torch.uint8)
+    return {"zero": int((b == 0).sum()), "subnormal": int(((b > 0) & (b < 128)).sum()),
+            "normal": int((b >= 128).sum())}
+
+
+# ------------------------------------------------------------------ test decoder
+def _bf16_bits_to_float(bits: torch.Tensor) -> torch.Tensor:
+    return (bits.to(torch.int32) << 16).view(torch.float32)
+
+
+def okc_decode_stage_block(block: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """Kernel-formula decode of one stage block: values [16 warps, 2 tiles, 16 rows, 128 k].
+
+    Returns (weight bf16 products as fp32, the same shape) using the kernel's
+    shift/mask/rotate formulas and its scale decode, i.e. value * 2^-126 * E4M3 * 2^7.
+    """
+    w = block[:8192].to(torch.int64) & 0xFFFFFFFF
+    w = w.view(16, 4, 32, 4)  # warp v lane cw
+    m32 = 0xFFFFFFFF
+    a0 = (w << 2) & T_MASK
+    a1 = (w << 6) & T_MASK
+    a2 = (((w << 12) | (w >> 20)) & m32) & T_MASK
+    a3 = (w & 0x81808180) + ((w & 0x40004000) >> 8)
+    regs = torch.stack([a0, a1, a2, a3], dim=-1)  # warp v lane cw r
+    lo = _bf16_bits_to_float(regs & 0xFFFF)
+    hi = _bf16_bits_to_float(regs >> 16)
+    vals = torch.stack([lo, hi], dim=-1)  # warp v lane cw r h
+    sb = block[8192:].contiguous().view(torch.uint8).view(16, 8, 4, 2, 4).to(torch.int32)  # warp g v j byte
+    sbits = (sb << 4) + (112 << 7)
+    sval = _bf16_bits_to_float(sbits)  # warp g v j byte(c*2+hb)
+    out = torch.zeros(16, 2, 16, 128, device=block.device)
+    lane = torch.arange(32, device=block.device)
+    g, t = lane >> 2, lane & 3
+    for v in range(4):
+        for cw in range(4):
+            kt, j = 2 * v + (cw >> 1), cw & 1
+            hb = cw >> 1
+            for r in range(4):
+                c, b = r & 1, r >> 1
+                row = g + 8 * c
+                for h in range(2):
+                    k = 16 * kt + 2 * t + 8 * b + h
+                    sc = sval[:, g, v, j, c * 2 + hb]  # [16 warps, 32 lanes]
+                    out[:, j, row, k] = vals[:, v, :, cw, r, h] * sc
+    return out
