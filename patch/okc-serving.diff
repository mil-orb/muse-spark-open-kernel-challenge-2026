@@ -0,0 +1,133 @@
+# SPDX-License-Identifier: Apache-2.0
+# 2026 the patch authors
+
+"""Serving entry for the stage-block NVFP4 expert kernels.
+
+`okc_rp_prepare` runs once per layer after stock Marlin preparation. When the
+layer has the shapes these kernels were built and measured for (SM90, 32 local
+experts, H = I = 4096, FP8 block scales, BF16 global scales, no biases) it
+repacks the experts into the okc_moe_repack.py stage blocks in place and frees
+the Marlin copies, so the layer holds one copy of its expert weights.
+
+`okc_rp_expert_outputs` then has stock `_marlin_expert_outputs`' contract:
+per-route expert outputs [M, top_k, 4096] and the local ids for stock's
+finalize. M <= 256 takes the persistent decode kernel, larger M the prefill
+GEMMs. Layers that do not qualify keep stock Marlin unchanged.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+
+_DECODE_MAX_M = 256
+
+
+def _qualifies(layer) -> bool:
+    w13 = getattr(layer, "w13_weight", None)
+    if w13 is None or not w13.is_cuda:
+        return False
+    if torch.cuda.get_device_capability(w13.device) != (9, 0):
+        return False
+    return (
+        layer.num_local_experts == 32
+        and layer.intermediate_size_per_partition == 4096
+        and tuple(layer.w13_weight.shape) == (32, 256, 16384)
+        and tuple(layer.w2_weight.shape) == (32, 256, 8192)
+        and layer.w13_weight.dtype == torch.int32
+        and layer.w2_weight.dtype == torch.int32
+        and layer.w13_weight_scale.dtype == torch.float8_e4m3fn
+        and layer.w2_weight_scale.dtype == torch.float8_e4m3fn
+        and layer.w13_weight_scale_2.dtype == torch.bfloat16
+        and layer.w2_weight_scale_2.dtype == torch.bfloat16
+        and tuple(layer.w13_weight_scale_2.shape) == (32,)
+        and tuple(layer.w2_weight_scale_2.shape) == (32,)
+        and getattr(layer, "w13_bias", None) is None
+        and getattr(layer, "w2_bias", None) is None
+    )
+
+
+def _set(layer, name: str, value: torch.Tensor) -> None:
+    if name in layer._parameters:
+        del layer._parameters[name]
+    elif hasattr(layer, name):
+        delattr(layer, name)
+    layer.register_parameter(name, torch.nn.Parameter(value, requires_grad=False))
+
+
+def _first_expert(layer):
+    """First global id of this rank's experts when they are one block in order, else None.
+
+    Then the decode kernel maps global ids itself (one subtraction) instead of the
+    host-side where / index chain. None keeps that chain (also when there is no map).
+    """
+    em = getattr(layer, "_expert_map", None)
+    if em is None:
+        return None
+    em = em.detach().to("cpu", torch.int64)
+    idx = torch.nonzero(em >= 0).flatten()
+    if idx.numel() != 32:
+        return None
+    first = int(idx[0])
+    if not torch.equal(idx, torch.arange(first, first + 32)) or not torch.equal(em[idx], torch.arange(32)):
+        return None
+    return first
+
+
+def okc_rp_prepare(layer) -> bool:
+    """Repack a qualifying layer in place. Returns True when the layer now uses these kernels."""
+    if os.environ.get("OKC_RP", "1") != "1" or not _qualifies(layer):
+        layer._okc_rp = False
+        return False
+    from sglang.kernels.ops.moe.okc_moe_repack import okc_repack_layer
+
+    w13, w2 = okc_repack_layer(layer.w13_weight, layer.w13_weight_scale, layer.w2_weight, layer.w2_weight_scale)
+    empty = torch.empty((0,), dtype=torch.uint8, device=w13.device)
+    _set(layer, "w13_weight", w13)
+    _set(layer, "w2_weight", w2)
+    # The block scales now live inside the stage blocks.
+    _set(layer, "w13_weight_scale", empty)
+    _set(layer, "w2_weight_scale", empty.clone())
+    layer._okc_first_expert = _first_expert(layer)
+    layer._okc_rp = True
+    torch.cuda.empty_cache()
+    # Build both JIT modules now (cached after the first layer) so no request
+    # waits for a compile.
+    from sglang.kernels.ops.moe import okc_moe_decode, okc_moe_prefill_rp
+
+    okc_moe_decode._module()
+    okc_moe_prefill_rp._module()
+    return True
+
+
+def _prefill_nt(m: int) -> int:
+    # Tile width by token count, from 1x H200 graph timings (see DECODE-LOG.md p03).
+    if m <= int(os.environ.get("OKC_RP_NT4_MAX", "1023")):
+        return 4
+    if m <= int(os.environ.get("OKC_RP_NT8_MAX", "1791")):
+        return 8
+    return 16
+
+
+def okc_rp_expert_outputs(layer, hidden_states, topk_scores, topk_ids):
+    m, hidden = hidden_states.shape
+    if m == 0:
+        return hidden_states.new_empty((0, topk_ids.shape[1], hidden)), topk_ids.to(torch.int32)
+    if hidden != 4096 or hidden_states.dtype != torch.bfloat16 or topk_ids.shape[1] != 8:
+        raise ValueError("stage-block expert kernels take [M, 4096] bf16 activations and top-8 routing")
+    if m <= _DECODE_MAX_M:
+        from sglang.kernels.ops.moe.okc_moe_decode import okc_decode_expert_outputs
+
+        return okc_decode_expert_outputs(layer, hidden_states, topk_scores, topk_ids)
+    from sglang.kernels.ops.moe.okc_moe_prefill_rp import okc_prefill_rp_expert_outputs
+
+    return okc_prefill_rp_expert_outputs(
+        layer, hidden_states, topk_scores, topk_ids, layer.w13_weight, layer.w2_weight, nt=_prefill_nt(m)
+    )
+
+
+def okc_expert_outputs_or(layer, hidden_states, topk_scores, topk_ids, stock_fn):
+    if getattr(layer, "_okc_rp", False):
+        return okc_rp_expert_outputs(layer, hidden_states, topk_scores, topk_ids)
+    return stock_fn(layer, hidden_states, topk_scores, topk_ids)
